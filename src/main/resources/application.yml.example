spring:
  datasource:
    url: jdbc:mysql://localhost:3306/fmhy_clone?useSSL=false&serverTimezone=UTC
    username: fmhy_app
    password: CHANGE_ME
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: validate   # Flyway manages the schema; Hibernate just validates
    show-sql: false
  flyway:
    enabled: true
  data:
    redis:
      host: localhost
      port: 6379

app:
  jwt:
    secret: CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_256_BITS
    expiration-ms: 86400000   # 24 hours

server:
  port: 8080